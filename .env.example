# Civil Rights Hub - Safe Environment Template
# Copy to a local environment file and provide values through the appropriate secret store.
# NEVER commit real credentials.

# --- BROWSER-SAFE SUPABASE CONFIGURATION ---
# VITE_* values are bundled into browser code and are NOT secret storage.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_APP_URL=https://civilrightshub.org

# --- SENTRY CLIENT OBSERVABILITY ---
# The DSN is a client ingestion endpoint, not a privileged server secret.
# Leave blank to disable Sentry locally. Do not put auth tokens in VITE_* variables.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- SERVER/CI ONLY: NEVER EXPOSE THROUGH VITE_* ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-management-access-token
SUPABASE_DB_PASSWORD=your-database-password

# --- STRIPE: SERVER VALUES STAY SERVER-SIDE ---
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_example
STRIPE_PREMIUM_ATTORNEY_PRICE_ID=price_example

# --- EDGE CACHING / APPLICATION RUNTIME ---
CACHE_CONTROL_STATE_GUIDES=public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
EDGE_CACHE_INVALIDATION_SECRET=change-me-in-production-secret-store

# --- FOIA ENGINE SETTINGS ---
MAX_FOIA_LETTER_LENGTH=20000
DEFAULT_FOIA_FEE_LIMIT=50
