VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- STRIPE BILLING & ATTORNEY DIRECTORY ---
STRIPE_SECRET_KEY=sk_test_51MockSecretKey00000000000000
STRIPE_WEBHOOK_SECRET=whsec_mockWebhookSecretKey00000000000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51MockPublishableKey00000000
